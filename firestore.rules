rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User isolated data paths: each user can only read and write their own data
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{collectionName}/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /settings/{settingDoc} {
        allow read, write: if isOwner(userId);
      }
    }

    // Top-level user account profiles (for auth sync)
    match /userAccounts/{accountId} {
      allow read, write: if isSignedIn();
    }

    // Fallback: Default deny for anything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
