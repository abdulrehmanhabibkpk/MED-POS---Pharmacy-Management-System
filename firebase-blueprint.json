{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile in root users collection",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "storeName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "email"]
    },
    "Product": {
      "title": "Product",
      "description": "Product item in user inventory",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "barcode": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "category": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "retailPrice": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "stock": { "type": "number" },
        "minStockAlert": { "type": "number" },
        "unitOfSale": { "type": "string" },
        "expiryDate": { "type": "string" },
        "formula": { "type": "string" },
        "shelfRack": { "type": "string" },
        "batchNo": { "type": "string" }
      },
      "required": ["id", "userId", "barcode", "name", "retailPrice", "stock"]
    },
    "SaleInvoice": {
      "title": "SaleInvoice",
      "description": "Point of sale invoice record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "invoiceNo": { "type": "number" },
        "date": { "type": "string" },
        "customerName": { "type": "string" },
        "saleType": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "discountAmount": { "type": "number" },
        "netAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "changeAmount": { "type": "number" },
        "cashier": { "type": "string" }
      },
      "required": ["id", "userId", "invoiceNo", "date", "netAmount", "cashier"]
    },
    "SaleReturn": {
      "title": "SaleReturn",
      "description": "Returned sales item record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "invoiceId": { "type": "string" },
        "date": { "type": "string" },
        "barcode": { "type": "string" },
        "itemName": { "type": "string" },
        "qty": { "type": "number" },
        "refundAmount": { "type": "number" },
        "reason": { "type": "string" },
        "cashier": { "type": "string" }
      },
      "required": ["id", "userId", "date", "qty", "refundAmount"]
    },
    "PurchaseRecord": {
      "title": "PurchaseRecord",
      "description": "Stock purchase inward record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "date": { "type": "string" },
        "supplierName": { "type": "string" },
        "supplierId": { "type": "string" },
        "barcode": { "type": "string" },
        "itemName": { "type": "string" },
        "qtyReceived": { "type": "number" },
        "unitCostPrice": { "type": "number" },
        "salePriceRetail": { "type": "number" },
        "wholesalePrice": { "type": "number" },
        "totalCost": { "type": "number" }
      },
      "required": ["id", "userId", "date", "barcode", "itemName", "qtyReceived", "totalCost"]
    },
    "CreditPayment": {
      "title": "CreditPayment",
      "description": "Credit payment recovery record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "date": { "type": "string" },
        "customerName": { "type": "string" },
        "amountReceived": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "userId", "date", "customerName", "amountReceived"]
    },
    "ExpenseRecord": {
      "title": "ExpenseRecord",
      "description": "Store operational expense entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "date": { "type": "string" },
        "category": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "recordedBy": { "type": "string" }
      },
      "required": ["id", "userId", "date", "category", "amount"]
    },
    "Supplier": {
      "title": "Supplier",
      "description": "Supplier vendor profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "name": { "type": "string" },
        "company": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "balanceOwed": { "type": "number" }
      },
      "required": ["id", "userId", "name"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Customer ledger profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "balanceReceivable": { "type": "number" }
      },
      "required": ["id", "userId", "name"]
    },
    "CustomerTransaction": {
      "title": "CustomerTransaction",
      "description": "Customer ledger transaction entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "referenceNo": { "type": "string" },
        "description": { "type": "string" },
        "debit": { "type": "number" },
        "credit": { "type": "number" },
        "balance": { "type": "number" }
      },
      "required": ["id", "userId", "customerId", "customerName", "date", "type"]
    },
    "SupplierTransaction": {
      "title": "SupplierTransaction",
      "description": "Supplier ledger transaction entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "supplierId": { "type": "string" },
        "supplierName": { "type": "string" },
        "date": { "type": "string" },
        "type": { "type": "string" },
        "referenceNo": { "type": "string" },
        "description": { "type": "string" },
        "debit": { "type": "number" },
        "credit": { "type": "number" },
        "balance": { "type": "number" }
      },
      "required": ["id", "userId", "supplierId", "supplierName", "date", "type"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Store configuration and preferences",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "storeId": { "type": "string" },
        "storeName": { "type": "string" },
        "tagline": { "type": "string" },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "logoUrl": { "type": "string" },
        "currency": { "type": "string" },
        "footerNote": { "type": "string" },
        "defaultPaperSize": { "type": "string" }
      },
      "required": ["userId", "storeName", "currency"]
    },
    "UserAccount": {
      "title": "UserAccount",
      "description": "Authorized user account",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" }
      },
      "required": ["id", "name", "email", "role"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document containing all subcollections scoped with storeId"
    },
    "/users/{userId}/products/{productId}": {
      "schema": "Product",
      "description": "All inventory products for this user store"
    },
    "/users/{userId}/sales/{saleId}": {
      "schema": "SaleInvoice",
      "description": "All sales invoices for this user store"
    },
    "/users/{userId}/returns/{returnId}": {
      "schema": "SaleReturn",
      "description": "All returns for this user store"
    },
    "/users/{userId}/purchases/{purchaseId}": {
      "schema": "PurchaseRecord",
      "description": "All purchases for this user store"
    },
    "/users/{userId}/credits/{creditId}": {
      "schema": "CreditPayment",
      "description": "All credit recovery payments for this user store"
    },
    "/users/{userId}/expenses/{expenseId}": {
      "schema": "ExpenseRecord",
      "description": "All store expenses for this user store"
    },
    "/users/{userId}/suppliers/{supplierId}": {
      "schema": "Supplier",
      "description": "All suppliers for this user store"
    },
    "/users/{userId}/customers/{customerId}": {
      "schema": "Customer",
      "description": "All customers for this user store"
    },
    "/users/{userId}/customerTransactions/{txId}": {
      "schema": "CustomerTransaction",
      "description": "All customer ledger entries for this user store"
    },
    "/users/{userId}/supplierTransactions/{txId}": {
      "schema": "SupplierTransaction",
      "description": "All supplier ledger entries for this user store"
    },
    "/users/{userId}/settings/{settingId}": {
      "schema": "StoreSettings",
      "description": "Store settings for this user store"
    },
    "/userAccounts/{userId}": {
      "schema": "UserAccount",
      "description": "All authorized user accounts"
    }
  }
}
