{
  "id": "com.medpos.scanner.app",
  "name": "MED POS Barcode Scanner",
  "short_name": "MED Scanner",
  "description": "Fast Pharmacy & Store Barcode Scanner App for Android",
  "start_url": "/?mode=scanner",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "window-controls-overlay"],
  "orientation": "portrait",
  "background_color": "#002b49",
  "theme_color": "#002b49",
  "categories": ["business", "utilities", "productivity"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "192x192 512x512",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ]
}
